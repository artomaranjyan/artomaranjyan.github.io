---
layout: default
---
<div class="post about-page">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span>
        {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc publication-name">{{ page.subtitle }}</p>
  </header>

  {% if page.profile %}
    <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
      {% if page.profile.image %}
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% assign profile_zoom_path = page.profile.zoom_image | default: page.profile.image | prepend: 'assets/img/' %}
        {% if page.profile.image_circular %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
        {% else %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
        {% endif %}
        {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 88px{% endcapture %}
        {% include figure.liquid loading="eager" path=profile_image_path zoom_path=profile_zoom_path class=profile_image_class sizes=sizes alt="Arto Maranjyan" cache_bust=true portrait_zoom=true width="3718" height="3226" %}
      {% endif %}
      <div class="profile-caption">
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% else %}
          <div class="typed-info"></div>
          <script>
            var options = {
              strings: ['Born in Armenia 🍖', 'Lived in Saudi Arabia 🐪', 'Enjoy Dancing Bachata 💃🕺', 'Catan Master 🎲', 'Night Owl 🦉'],
              typeSpeed: 30,
              backSpeed: 20,
              loop: true,
              shuffle: false,
              showCursor: true,
              cursorChar: '|',
              // fadeOut: true,
            };

            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
            let typed;
            const updateCaptionMotion = () => {
              if (typed) {
                typed.destroy();
                typed = null;
              }
              if (reducedMotion.matches) {
                document.querySelector('.typed-info').textContent = options.strings[0];
              } else {
                typed = new Typed('.typed-info', options);
              }
            };
            updateCaptionMotion();
            reducedMotion.addEventListener('change', updateCaptionMotion);
          </script>
        {% endif %}
      </div>
    </div>
  {% endif %}
  <article>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">Recent News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest Posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
{% if page.profile.image and site.enable_medium_zoom %}
  <dialog class="portrait-viewer" id="portrait-viewer" aria-label="Portrait of Arto Maranjyan">
    <button class="portrait-viewer-close" type="button" aria-label="Close portrait" autofocus>&times;</button>
    <img class="portrait-viewer-image" alt="Arto Maranjyan" width="3718" height="3226" decoding="async">
    <p class="portrait-viewer-error" hidden>
      The photo could not load. <a href="{{ profile_image_path | relative_url | bust_file_cache }}">Open full-size photo</a>.
    </p>
  </dialog>
{% endif %}
