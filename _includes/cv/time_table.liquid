{% for content in entry.contents %}
  <div class="cv-entry">
    <div class="cv-entry-head">
      {% if content.title %}
        <h3 class="cv-role">{{ content.title }}</h3>
      {% endif %}
      {% if content.year %}
        <div class="cv-date">{{ content.year }}</div>
      {% endif %}
    </div>
    {% if content.institution or content.location %}
      <p class="cv-institution">
        {{- content.institution -}}
        {% if content.location %}
          {% if content.institution -%}
            <span class="cv-meta-separator"> · </span>
          {%- endif %}
          <span class="cv-location">{{ content.location }}</span>
        {% endif %}
      </p>
    {% endif %}
    {% if content.department %}
      <p class="cv-department">{{ content.department }}</p>
    {% endif %}
    {% if content.maindescription %}
      <div class="cv-description">{{ content.maindescription }}</div>
    {% endif %}
    {% assign note_fields = 'description,items' | split: ',' %}
    {% for field in note_fields %}
      {% assign notes = content[field] %}
      {% if notes != blank %}
        <ul class="cv-notes">
          {% if notes.first %}
            {% for item in notes %}
              <li>
                {% if item.contents %}
                  <span>{{ item.title }}</span>
                  <ul>
                    {% for subitem in item.contents %}
                      <li>{{ subitem }}</li>
                    {% endfor %}
                  </ul>
                {% else %}
                  {{ item }}
                {% endif %}
              </li>
            {% endfor %}
          {% else %}
            <li>{{ notes }}</li>
          {% endif %}
        </ul>
      {% endif %}
    {% endfor %}
    {% if content.linkitems %}
      <div class="cv-entry-links">
        {% for item in content.linkitems %}
          {% if item.link %}
            <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer" class="btncv z-depth-0">
              {{- item.linkname | default: 'doc' -}}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endfor %}
